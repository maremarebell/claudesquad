      div.addEventListener('click', function(e) {
        e.stopPropagation();
        const holidayName = this.getAttribute('data-holiday-name');
        if (holidayName) {
          // Create or update tooltip
          let tooltip = this.querySelector('.calendar__holiday-tooltip-click');
          if (tooltip) {
            tooltip.remove();
          } else {
            tooltip = document.createElement('div');
            tooltip.className = 'calendar__holiday-tooltip-click';
            tooltip.textContent = holidayName;
            this.appendChild(tooltip);
          }
        }
      });
    });
    
    // Event tooltip on click (show/hide)
    const eventDivsWithNames = document.querySelectorAll('.calendar__day--event[data-event-name]');
    eventDivsWithNames.forEach(div => {
      div.addEventListener('click', function(e) {
        e.stopPropagation();
        const eventName = this.getAttribute('data-event-name');
        if (eventName) {
          // Create or update tooltip
          let tooltip = this.querySelector('.calendar__event-tooltip-click');
          if (tooltip) {
            tooltip.remove();
          } else {
            tooltip = document.createElement('div');
            tooltip.className = 'calendar__event-tooltip-click';
            tooltip.textContent = eventName;
            this.appendChild(tooltip);
          }
        }
      });
    });
    
    // Highlight today's date
    const today = new Date();
    const todayDate = today.getDate();
    const todayMonth = today.getMonth() + 1; // JavaScript months are 0-indexed
    const todayYear = today.getFullYear();
    
    // Find all calendar day numbers
    const dayNumbers = document.querySelectorAll('.calendar__day-number');
    dayNumbers.forEach(dayNum => {
      const dayValue = parseInt(dayNum.textContent.trim());
      if (!isNaN(dayValue) && dayValue === todayDate) {
        // Check if this is in the correct month/year by looking at the month header
        const monthBlock = dayNum.closest('.calendar__month-block');
        if (monthBlock) {
          const monthHeader = monthBlock.querySelector('.calendar__month-name');
          const yearHeader = monthBlock.querySelector('.calendar__month-year');
          
          if (monthHeader && yearHeader) {
            const monthNames = ['January', 'February', 'March', 'April', 'May', 'June', 
                              'July', 'August', 'September', 'October', 'November', 'December'];
            const monthText = monthHeader.textContent.trim();
            const monthIndex = monthNames.indexOf(monthText);
            const year = parseInt(yearHeader.textContent.trim());
            
            if (monthIndex !== -1 && monthIndex === todayMonth - 1 && year === todayYear) {
              const dayDiv = dayNum.closest('.calendar__day');
              if (dayDiv && !dayDiv.classList.contains('calendar__day--empty')) {
                dayDiv.classList.add('calendar__day--today');
              }
            }
          }
        }
      }
    });
    
    // Semester filter functionality
    const scheduleItems = document.querySelectorAll('.calendar__schedule-item');
    let activeSemester = null;
    
    scheduleItems.forEach(item => {
      item.style.cursor = 'pointer';
      item.addEventListener('click', function() {
        const semester = this.getAttribute('data-semester');
        
        // Toggle: if clicking the same semester, reset
        if (activeSemester === semester) {
          activeSemester = null;
          this.classList.remove('calendar__schedule-item--active');
        } else {
          activeSemester = semester;
          // Remove active class from all items
          scheduleItems.forEach(i => i.classList.remove('calendar__schedule-item--active'));
          // Add active class to clicked item
          this.classList.add('calendar__schedule-item--active');
        }
        
        // Map semester names to their CSS variable names
        const semesterEventVars = {
          'winter-spring': '--calendar-winter-spring-event',
          'summer': '--calendar-summer-event',
          'fall': '--calendar-fall-event',
          'spring-2027': '--calendar-spring-2027-event'
        };
        
        // Dim all calendar days
        const allDays = document.querySelectorAll('.calendar__day:not(.calendar__day--empty)');
        const allMonthBlocks = document.querySelectorAll('.calendar__month-block');
        
        allDays.forEach(day => {
          if (activeSemester === null) {
            // Reset: show all
            day.classList.remove('calendar__day--dimmed');
          } else {
            const expectedVar = semesterEventVars[activeSemester];
            const isActiveSemester = day.classList.contains(`calendar__day--${activeSemester}`);
            
            // For events, check the actual event color using CSS variable
            let isSemesterEvent = false;
            let isOtherSemesterEvent = false;
            
            if (day.classList.contains('calendar__day--blocked')) {
              const styleAttr = day.getAttribute('style') || '';
              
              // Check if the style attribute contains the expected CSS variable
              if (styleAttr.includes(expectedVar)) {
                isSemesterEvent = true;
              } else {
                // Check if it's an event for a different semester (not holidays)
                const isHoliday = day.classList.contains('calendar__day--holiday');
                if (!isHoliday && styleAttr.includes('background')) {
                  // It's an event but not the active semester's color - check all other semester variables
                  for (const [sem, varName] of Object.entries(semesterEventVars)) {
                    if (sem !== activeSemester && styleAttr.includes(varName)) {
                      isOtherSemesterEvent = true;
                      break;
                    }
                  }
                }
              }
            }
            
            // For events: prioritize event color over background class
            // For non-events: use background class
            if (day.classList.contains('calendar__day--blocked')) {
              // It's an event - show only if it matches the active semester's color
              if (isSemesterEvent) {
                day.classList.remove('calendar__day--dimmed');
              } else {
                day.classList.add('calendar__day--dimmed');
              }
            } else {
              // It's not an event - show if it has the semester background class
              if (isActiveSemester) {
                day.classList.remove('calendar__day--dimmed');
              } else {
                day.classList.add('calendar__day--dimmed');
              }
            }
          }
        });
        
        // Also dim month blocks that don't contain the active semester
        allMonthBlocks.forEach(block => {
          if (activeSemester === null) {
            block.classList.remove('calendar__month-block--dimmed');
          } else {
            // Check if block has any non-dimmed days
            const hasActiveSemester = block.querySelector(`.calendar__day--${activeSemester}:not(.calendar__day--empty)`);
            const hasSemesterEvent = Array.from(block.querySelectorAll('.calendar__day--blocked:not(.calendar__day--empty)')).some(day => {
              const styleAttr = day.getAttribute('style') || '';
              const expectedVar = semesterEventVars[activeSemester];
              return styleAttr.includes(expectedVar);
            });
            
            if (hasActiveSemester || hasSemesterEvent) {
              block.classList.remove('calendar__month-block--dimmed');
            } else {
              block.classList.add('calendar__month-block--dimmed');
            }
          }
        });
      });
    });
  });
</script>
