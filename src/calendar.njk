---
layout: base.njk
title: Calendar
---

<div class="calendar">
  <header class="calendar__header">
    <h1 class="calendar__title page-title">2026</h1>
    <span class="calendar__subtitle page-subtitle">Academic Calendar</span>
  </header>

  <div class="calendar__schedule-legend-wrapper">
    <div class="calendar__schedule">
      <h2 class="calendar__schedule-title">Semester Schedule</h2>
      <div class="calendar__schedule-list">
        <div class="calendar__schedule-item" data-semester="winter-spring">
          <div class="calendar__schedule-semester-wrapper">
            <span class="calendar__schedule-color-box"></span>
            <span class="calendar__schedule-semester">Winter 2026</span>
          </div>
          <span class="calendar__schedule-range">Jan 5 - Apr 19</span>
          <ul class="calendar__schedule-dates-list">
            <li class="calendar__schedule-date">1/5 Course schedule announced</li>
            <li class="calendar__schedule-date">1/15 Application deadline</li>
            <li class="calendar__schedule-date">4/19 End of semester party</li>
          </ul>
        </div>
        <div class="calendar__schedule-item" data-semester="summer">
          <div class="calendar__schedule-semester-wrapper">
            <span class="calendar__schedule-color-box"></span>
            <span class="calendar__schedule-semester">Summer 2026</span>
          </div>
          <span class="calendar__schedule-range">May 31 - Aug 15</span>
          <ul class="calendar__schedule-dates-list">
            <li class="calendar__schedule-date">5/7 Course schedule announced</li>
            <li class="calendar__schedule-date">5/21 Application deadline</li>
            <li class="calendar__schedule-date">5/28 Enrollment confirmation</li>
            <li class="calendar__schedule-date">5/31 Semester kickoff</li>
            <li class="calendar__schedule-date">8/15 End of semester party</li>
          </ul>
        </div>
        <div class="calendar__schedule-item" data-semester="fall">
          <div class="calendar__schedule-semester-wrapper">
            <span class="calendar__schedule-color-box"></span>
            <span class="calendar__schedule-semester">Fall 2026</span>
          </div>
          <span class="calendar__schedule-range">Aug 23 - Dec 13</span>
          <ul class="calendar__schedule-dates-list">
            <li class="calendar__schedule-date">7/30 Course schedule announced</li>
            <li class="calendar__schedule-date">8/13 Application deadline</li>
            <li class="calendar__schedule-date">8/20 Enrollment confirmation</li>
            <li class="calendar__schedule-date">8/23 Semester kickoff</li>
            <li class="calendar__schedule-date">12/13 End of semester party</li>
          </ul>
        </div>
        <div class="calendar__schedule-item" data-semester="spring-2027">
          <div class="calendar__schedule-semester-wrapper">
            <span class="calendar__schedule-color-box"></span>
            <span class="calendar__schedule-semester">Spring 2027</span>
          </div>
          <span class="calendar__schedule-range">Starting Jan 3</span>
          <ul class="calendar__schedule-dates-list">
            <li class="calendar__schedule-date">12/11 Course schedule announced</li>
            <li class="calendar__schedule-date">12/24 Application deadline</li>
            <li class="calendar__schedule-date">12/31 Enrollment confirmation</li>
            <li class="calendar__schedule-date">1/3 2027 Semester kick-off</li>
          </ul>
        </div>
      </div>
    </div>
  </div>

  <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 20px; flex-wrap: wrap;">
    <label class="calendar__toggle-switch">
      <input type="checkbox" id="holiday-toggle" class="calendar__toggle-input">
      <span class="calendar__toggle-slider"></span>
      <span class="calendar__toggle-label">Holidays</span>
    </label>
    {# <label class="calendar__toggle-switch">
      <input type="checkbox" id="teacher-toggle" class="calendar__toggle-input">
      <span class="calendar__toggle-slider"></span>
      <span class="calendar__toggle-label">Teacher</span>
    </label> #}
    <div class="calendar__legend-inline">
      <div class="calendar__legend-items">
        <div class="calendar__legend-item">
          <span class="calendar__legend-emoji">📅</span>
          <span class="calendar__legend-label">Course schedule announced</span>
        </div>
        <div class="calendar__legend-item">
          <span class="calendar__legend-emoji">📝</span>
          <span class="calendar__legend-label">Application deadlines</span>
        </div>
        <div class="calendar__legend-item">
          <span class="calendar__legend-emoji">🔒</span>
          <span class="calendar__legend-label">Enrollment confirmation</span>
        </div>
        <div class="calendar__legend-item">
          <span class="calendar__legend-emoji">🎉</span>
          <span class="calendar__legend-label">End of semester parties</span>
        </div>
        <div class="calendar__legend-item">
          <span class="calendar__legend-emoji">🏁</span>
          <span class="calendar__legend-label">Semester kickoffs</span>
        </div>
        {# <div class="calendar__legend-item">
          <span class="calendar__legend-emoji">👩‍🏫</span>
          <span class="calendar__legend-label">Teacher deadlines</span>
        </div> #}
        <div class="calendar__legend-item">
          <span class="calendar__legend-emoji">🎊</span>
          <span class="calendar__legend-label">Holidays</span>
        </div>
      </div>
    </div>
  </div>

  <div class="calendar__grid">
    {% set events = {
      '2026-07-04': { cat: 'holiday', label: 'Independence Day', color: '#744210' },
      '2026-08-30': { cat: 'holiday', label: 'Burning Man', color: '#744210' },
      '2026-08-31': { cat: 'holiday', label: 'Burning Man', color: '#744210' },
