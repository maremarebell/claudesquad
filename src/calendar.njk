---
layout: base.njk
title: 2026 Calendar
---

<div class="calendar">
  <header class="calendar__header">
    <h1 class="calendar__title page-title">2026</h1>
    <span class="calendar__subtitle page-subtitle">Calendar</span>
  </header>

  <div class="calendar__grid">
    {% for month in calendarMonths %}
      <div class="calendar__month-block{% if month.isPast %} calendar__month-block--past{% endif %}">
        <div class="calendar__month-header">
          <span class="calendar__month-name">{{ month.name }}</span>
          <span class="calendar__month-year">{{ month.year }}</span>
        </div>
        <table class="calendar__table">
          <thead>
            <tr>
              <th class="calendar__th">Sun</th>
              <th class="calendar__th">Mon</th>
              <th class="calendar__th">Tue</th>
              <th class="calendar__th">Wed</th>
              <th class="calendar__th">Thu</th>
              <th class="calendar__th">Fri</th>
              <th class="calendar__th">Sat</th>
            </tr>
          </thead>
          <tbody>
            {% for week in month.weeks %}
              <tr>
                {% for day in week %}
                  <td>
                    {% if not day %}
                      <div class="calendar__day calendar__day--empty"></div>
                    {% elif day.events.length %}
                      {% set event = day.events[0] %}
                      <a href="{{ event.partiful or '#' }}"
                         {% if event.partiful %}target="_blank" rel="noopener"{% endif %}
                         class="calendar__day calendar__day--event{% if day.isToday %} calendar__day--today{% endif %}{% if not event.partiful %} calendar__day--no-link{% endif %}"
                         data-event-name="{{ event.tooltip }}"
                         style="background: {{ event.color or 'var(--accent)' }};">
                        <span class="calendar__day-number">{{ day.day }}</span>
                        {% if event.emoji %}<span class="calendar__day-emoji">{{ event.emoji }}</span>{% endif %}
                      </a>
                    {% else %}
                      <div class="calendar__day{% if day.isToday %} calendar__day--today{% endif %}">
                        <span class="calendar__day-number">{{ day.day }}</span>
                      </div>
                    {% endif %}
                  </td>
                {% endfor %}
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    {% endfor %}
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    // Days without a Partiful link yet: tap/click toggles a tooltip instead of navigating.
    document.querySelectorAll('.calendar__day--no-link').forEach(el => {
      el.addEventListener('click', function(e) {
        e.preventDefault();
        e.stopPropagation();
        let tooltip = this.querySelector('.calendar__event-tooltip-click');
        if (tooltip) {
          tooltip.remove();
        } else {
          tooltip = document.createElement('div');
          tooltip.className = 'calendar__event-tooltip-click';
          tooltip.textContent = this.getAttribute('data-event-name');
          this.appendChild(tooltip);
        }
      });
    });
  });
</script>
