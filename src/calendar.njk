<script>
  document.addEventListener('DOMContentLoaded', function() {
    const toggle = document.getElementById('holiday-toggle');
    const holidayDivs = document.querySelectorAll('.calendar__day--holiday');
    
    // Hide holiday styling by default (add hidden class)
    holidayDivs.forEach(div => {
      div.classList.add('calendar__day--holiday-hidden');
      const emoji = div.querySelector('.calendar__day-emoji');
      if (emoji) {
        emoji.style.display = 'none';
      }
    });
    
    // Toggle holiday styling when checkbox changes
    toggle.addEventListener('change', function() {
      holidayDivs.forEach(div => {
        if (this.checked) {
          // Show holiday: remove hidden class, show emoji
          div.classList.remove('calendar__day--holiday-hidden');
          const emoji = div.querySelector('.calendar__day-emoji');
          if (emoji) {
            emoji.style.display = '';
          }
        } else {
          // Hide holiday: add hidden class, hide emoji
          div.classList.add('calendar__day--holiday-hidden');
          const emoji = div.querySelector('.calendar__day-emoji');
          if (emoji) {
            emoji.style.display = 'none';
          }
        }
      });
    });
    
    // Teacher toggle functionality
    // const teacherToggle = document.getElementById('teacher-toggle');
    // const teacherEmojis = document.querySelectorAll('.calendar__day-emoji');
