{# The panel is a React app (here.js). This is what shows until it mounts, and
   what stays if it never does: the same bar, title and status line. #}
<div id="here-root">
  <div class="here" id="here">
    <div class="here__bar" aria-hidden="true"><span>[ Claude Squad ]</span><span>NYC</span></div>
    <h1 class="page-title" id="here-title">Log in</h1>
    <p class="here__status" id="here-status" role="status">Loading…</p>
  </div>
</div>

<script type="application/json" id="here-config">{{ { repo: site.repo, branch: site.branch, prRepos: prRepos, events: events } | dump | replace("<", "\\u003c") | safe }}</script>
{# React, htm and the renderer all resolve through this one map, so there is a
   single copy of three on the page: @react-three/fiber carries its own unless
   ?external says otherwise, and react/jsx-runtime is what fiber imports React
   by. three is the same file the homepage hero loads. #}
<script type="importmap">
{
  "imports": {
    "react": "https://esm.sh/react@19.0.0",
    "react/jsx-runtime": "https://esm.sh/react@19.0.0/jsx-runtime",
    "react-dom": "https://esm.sh/react-dom@19.0.0",
    "react-dom/client": "https://esm.sh/react-dom@19.0.0/client",
    "three": "https://unpkg.com/three@0.180.0/build/three.module.min.js",
    "@react-three/fiber": "https://esm.sh/@react-three/fiber@9.0.0?external=react,react-dom,three",
    "htm": "https://esm.sh/htm@3.1.1"
  }
}
</script>
<script>
  // If React never arrives (no signal, a blocked CDN), the page says so
  // instead of sitting on "Loading…". A classic script, so it is already
  // listening before the module loads.
  (function () {
    var say = function () {
      var s = document.getElementById('here-status');
      if (s && s.textContent === 'Loading…') s.textContent = "Couldn't load the page. Check your signal and reload.";
    };
    addEventListener('error', function (e) { if (e.target && e.target.tagName === 'SCRIPT') say(); }, true);
    setTimeout(say, 15000);
  })();
</script>
<script type="module" src="{{ js }}/here.js"></script>
