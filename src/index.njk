---
layout: base.njk
title: Home
---

<div class="hero">
  <h1 class="hero__title"><span>Claude</span><span>Squad</span></h1>
  <img src="/images/logo-840.png" width="840" height="600" alt="Make No Mistakes" class="hero__logo">

  <div class="hero__hud">
    <span class="hero__tag">NYC</span>

    {% if nextEvent %}
      <div class="hero__meetup ticks">
        <span class="hero__label">[ Next Meetup ] <b id="tminus" data-date="{{ nextEvent.date }}"></b></span>
        <span class="hero__event">{{ nextEvent.title }}</span>
        <span class="hero__date">{{ nextEvent.dateLabel }}</span>
        {% if nextEvent.partiful %}
          <a href="{{ nextEvent.partiful }}" target="_blank" rel="noopener" class="hero__cta">RSVP on Partiful <span aria-hidden="true">→</span></a>
        {% else %}
          <a href="/calendar/" class="hero__cta">Calendar <span aria-hidden="true">→</span></a>
        {% endif %}
        <a href="/here/" class="hero__cta">Log in / Check in <span aria-hidden="true">→</span></a>
      </div>
    {% endif %}

    <p class="hero__tagline">Make No Mistakes.</p>
  </div>
</div>

<script>
  // days to the next meetup, counted in New York
  (function () {
    var el = document.getElementById('tminus');
    if (!el) return;
    var today = new Date().toLocaleDateString('en-CA', { timeZone: 'America/New_York' });
    var days = Math.round((Date.parse(el.dataset.date) - Date.parse(today)) / 864e5);
    el.textContent = days === 0 ? 'TODAY' : 'T-' + days + (days === 1 ? ' DAY' : ' DAYS');
  })();
</script>
<script type="importmap">
{ "imports": { "three": "https://unpkg.com/three@0.180.0/build/three.module.min.js" } }
</script>
<!-- three imports its core: fetch both now instead of one after the other -->
<link rel="modulepreload" href="https://unpkg.com/three@0.180.0/build/three.module.min.js" crossorigin>
<link rel="modulepreload" href="https://unpkg.com/three@0.180.0/build/three.core.min.js" crossorigin>
<script type="module" src="/js/hero.js"></script>

<div class="content">
  <h2>What is Claude Squad?</h2>
  <p>We are <mark>NYC's most elite fitness and computing club</mark>. <mark>We set PRs while we push PRs.</mark>
  We burn tokens while we burn calories. We <mark>friendshipmog and tokenmaxx</mark>.</p>
  <p>More specifically, we meet up ~every other week to prompt, lift, and friendshipmog everyone else in the area
  in matching tanks. When the weather is nice, we meet outside for calisthenics, otherwise we meet at the weights in Vital.</p>
  <p><mark>Everyone is welcome</mark>, whatever your skill level with working out and/or AI. It's all
  better with a squad!</p>
</div>

<section class="content board" id="board">
  <h2>Leaderboard</h2>
  <div>
    <p class="board__how">1 point for every meetup you check in at, 1 for every merged PR.</p>
    <ol class="board__list"></ol>
    <p class="board__status" role="status"></p>
    <p class="board__cta"><a href="/here/">Check in</a> · <a href="/projects/">Find something to PR</a></p>
  </div>
</section>
<script type="application/json" id="board-config">{{ { prRepos: prRepos, events: events } | dump | replace("<", "\\u003c") | safe }}</script>
<script type="module" src="/js/board.js"></script>

<div class="gallery">
  <h2>Photos</h2>
  {% set photos = collections.photo | reverse %}
  {% if photos.length %}
    <div class="gallery__grid">
      {% for photo in photos %}
        <figure class="gallery__item">
          <img src="{{ photo.data.image }}" alt="{{ photo.data.caption or photo.data.event or 'Claude Squad photo' }}" class="gallery__image" loading="lazy">
          {% if photo.data.caption or photo.data.event or photo.data.date %}
            <figcaption class="gallery__caption">
              {% if photo.data.event %}<span class="gallery__event">{{ photo.data.event }}</span>{% endif %}
              {% if photo.data.caption %}<span class="gallery__caption-text">{{ photo.data.caption }}</span>{% endif %}
              {% if photo.data.date %}<span class="gallery__date">{{ photo.data.date }}</span>{% endif %}
            </figcaption>
          {% endif %}
        </figure>
      {% endfor %}
    </div>
  {% else %}
    <p class="gallery__empty">No photos yet. Be the first to add one. See <code>CONTRIBUTING.md</code> in this repo for how to open a PR.</p>
  {% endif %}
</div>
